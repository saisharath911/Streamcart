{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=streamcart_orders;Username=postgres;Password=postgres"
  },
  "Messaging": {
    "TopicArn": "arn:aws:sns:us-east-1:000000000000:streamcart-events",
    "QueueName": "streamcart-orders",
    "ServiceUrl": "http://localhost:4566",
    "Region": "us-east-1"
  },
  "Saga": {
    "StepTimeout": "00:00:15",
    "ScanInterval": "00:00:02"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
